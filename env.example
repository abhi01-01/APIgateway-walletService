# Required for JWT verification. Must match Wallet Service.
JWT_SECRET=<base64-encoded-hmac-secret>

# Required by Wallet Service to verify gateway-originated traffic.
GATEWAY_INTERNAL_SECRET=<internal-gateway-shared-secret>

# Required in production. Comma-separated browser origins allowed to call the gateway.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Production profile and infrastructure.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
WALLET_SERVICE_URL=http://wallet-service:8081

# Production Redis. Use the values from the managed Redis provider.
REDIS_HOST=wallet-redis-d
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>

# Trusted proxy or load-balancer source IPs/CIDRs for X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
